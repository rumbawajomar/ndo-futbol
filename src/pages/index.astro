---
import ndoLogo from '../assets/ndo-logo.png';
import gallery1 from '../assets/DSC08927.jpg';
import gallery2 from '../assets/DSC08929.jpg';
import gallery3 from '../assets/IMG_2489.JPG';
import gallery4 from '../assets/IMG_2491.JPG';
import gallery5 from '../assets/IMG_2492.JPG';
import gallery6 from '../assets/IMG_2906.jpeg';
import gallery7 from '../assets/IMG_3202.jpeg';
import gallery8 from '../assets/IMG_3527.jpeg';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>NDO Futbol — Premier Soccer Development</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>

    <!-- NAV -->
    <nav id="main-nav">
      <a href="#" class="logo-link">
        <img src={ndoLogo.src} alt="NDO Futbol" class="nav-logo" />
      </a>
      <ul id="nav-links">
        <li><a href="#about">About</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#testimonials">Testimonials</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
      <a href="#contact" class="btn btn-nav nav-cta">Book a Session</a>
      <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>

    <!-- HERO -->
    <section class="hero" id="home">
      <div class="hero-bg"></div>
      <div class="hero-content">
        <p class="hero-eyebrow">Premier Soccer Development</p>
        <h1>Train with Intention.<br /><span>Build the Habit.<br />Trust the Process.</span></h1>
        <p class="hero-sub">
          Premier soccer development focused on technical growth, confidence, and long-term player success.
        </p>
        <div class="hero-cta">
          <a href="#contact" class="btn btn-primary">Book Your Session</a>
          <a href="#services" class="btn btn-outline">See Programs</a>
        </div>
      </div>
      <div class="hero-badge">
        <span class="badge-number">5+</span>
        <span class="badge-label">Years<br />Coaching</span>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="about" id="about">
      <div class="container">
        <div class="about-grid">
          <div class="about-visual">
            <div class="about-card">
              <div class="about-icon">⚽</div>
              <p class="about-stat">500+</p>
              <p class="about-stat-label">Players Trained</p>
            </div>
            <div class="about-card accent">
              <div class="about-icon">🏆</div>
              <p class="about-stat">15+</p>
              <p class="about-stat-label">Teams Coached</p>
            </div>
            <div class="about-card">
              <div class="about-icon">🎯</div>
              <p class="about-stat">100%</p>
              <p class="about-stat-label">Commitment</p>
            </div>
          </div>
          <div class="about-text">
            <p class="section-label">About NDO Futbol</p>
            <h2>More Than <span>Great Players</span></h2>
            <p>
              At NDO Futbol, the goal is bigger than developing great soccer players. We focus on building confident, disciplined, and hardworking athletes prepared for success both on and off the field.
            </p>
            <p>
              Coach Kevin created NDO Futbol with a passion for helping players maximize their potential through detailed technical training, competitive environments, and mentorship. Every session is designed to improve not only a player's skillset, but also their mentality, decision-making, work ethic, and confidence.
            </p>
            <p>
              NDO Futbol believes in high standards, accountability, and creating an environment where players are pushed to grow while still enjoying the process.
            </p>
            <div class="philosophy-tags">
              <span class="tag">Ball Mastery</span>
              <span class="tag">Speed & Agility</span>
              <span class="tag">Game Awareness</span>
              <span class="tag">Technical Development</span>
              <span class="tag">Athletic Movement</span>
              <span class="tag">Mental Toughness</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="services" id="services">
      <div class="container">
        <p class="section-label center">Programs</p>
        <h2 class="center">Training Built <span>For You</span></h2>
        <div class="services-grid two-col">
          <div class="service-card">
            <div class="service-icon">👤</div>
            <h3>Private Training</h3>
            <p>1-on-1 sessions focused on technical development, confidence, position-specific work, and individual weaknesses.</p>
            <ul>
              <li>60–75 minute sessions</li>
              <li>Personalized training program</li>
            </ul>
            <a href="#contact" class="btn btn-primary">Get Started</a>
          </div>
          <div class="service-card featured">
            <div class="featured-badge">Most Popular</div>
            <div class="service-icon">👥</div>
            <h3>Small Group Training</h3>
            <p>Designed to improve decision-making, speed of play, technical ability, and teamwork!</p>
            <ul>
              <li>Option to create your own group</li>
            </ul>
            <a href="#contact" class="btn btn-primary">Get Started</a>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="testimonials" id="testimonials">
      <div class="container">
        <p class="section-label center">Testimonials</p>
        <h2 class="center">What Players <span>Are Saying</span></h2>
        <div class="testimonials-grid">
          <div class="testimonial-card">
            <div class="stars">★★★★★</div>
            <p class="quote">"Kevin has been an incredible influence on my development. His deep understanding of the game, combined with his dedication and support, has helped me grow both technically and mentally. I started training with Kevin when I was on the second team of my club. From him pushing me to challenge myself, and always encouraging and believing in my potential, I am now a starter on the first team with a great amount of confidence and I am the second leader in goals. I'm truly grateful for his guidance and passion to do anything he can to help me pursue my dreams."</p>
            <div class="testimonial-author">
              <div class="author-avatar">M</div>
              <div>
                <p class="author-name">Mateo</p>
                <p class="author-role">Club Player</p>
              </div>
            </div>
          </div>
          <div class="testimonial-card featured">
            <div class="stars">★★★★★</div>
            <p class="quote">"I've been working with Coach Kevin for about 2 years now. During this time, I have seen many aspects of my game improve — technique, agility, confidence, strength, composure, to name a few. Kevin takes great pride and shows immense passion in his coaching, and always makes sure to connect with you and seeks to help you improve on the things you want to target. In addition, he always makes sure to personalize his sessions and makes you feel comfortable. I have recommended him to various players and nearly all of them are still training with him to this day. He is a great coach and always works to push me beyond what I thought was my limit every session."</p>
            <div class="testimonial-author">
              <div class="author-avatar">M</div>
              <div>
                <p class="author-name">Mason</p>
                <p class="author-role">Player</p>
              </div>
            </div>
          </div>
          <div class="testimonial-card">
            <div class="stars">★★★★★</div>
            <p class="quote">"Coach Kevin is one of the few coaches out there that actually cares about each and every one of his players. He shows up to every training knowing exactly what I need to improve on, and with drills that will do exactly that. He came to almost all my high school games to support me and when I would train with him later in the week he would know exactly what I needed to improve on, and tell me what I needed to hear. He pushed my confidence up so high when it was at an all time low and I'm so excited to continue to train with him during my upcoming ECNL season!"</p>
            <div class="testimonial-author">
              <div class="author-avatar">N</div>
              <div>
                <p class="author-name">Nora</p>
                <p class="author-role">ECNL Player</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY -->
    <section class="gallery" id="gallery">
      <div class="container">
        <p class="section-label center">Gallery</p>
        <h2 class="center">On the <span>Pitch</span></h2>
        <div class="gallery-grid">
          <div class="gallery-item">
            <img src={gallery1.src} alt="Training session on the pitch" />
          </div>
          <div class="gallery-item">
            <img src={gallery2.src} alt="Player working on ball control" />
          </div>
          <div class="gallery-item">
            <img src={gallery3.src} alt="Coach Kevin on the field" />
          </div>
          <div class="gallery-item">
            <img src={gallery7.src} alt="Team photo" />
          </div>
          <div class="gallery-item">
            <img src={gallery4.src} alt="Speed and agility training" />
          </div>
          <div class="gallery-item">
            <img src={gallery8.src} alt="Player with trophy" />
          </div>
          <div class="gallery-item">
            <img src={gallery5.src} alt="Players sprinting during training" />
          </div>
          <div class="gallery-item">
            <img src={gallery6.src} alt="Coach Kevin with player" />
          </div>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact" id="contact">
      <div class="container">
        <div class="contact-grid">
          <div class="contact-info">
            <p class="section-label">Get In Touch</p>
            <h2>Ready to <span>Level Up?</span></h2>
            <p>Book a session or reach out with questions. I respond within 24 hours.</p>
            <div class="contact-details">
              <div class="contact-item">
                <span class="contact-icon">📍</span>
                <span>Greater Metro Area</span>
              </div>
              <div class="contact-item">
                <span class="contact-icon">📧</span>
                <span>info@ndofutbol.com</span>
              </div>
              <div class="contact-item">
                <span class="contact-icon">📱</span>
                <span>Available via form below</span>
              </div>
            </div>
          </div>
          <form class="contact-form" action="#" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" name="name" placeholder="Your name" required />
              </div>
              <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="your@email.com" required />
              </div>
            </div>
            <div class="form-group">
              <label for="program">Program Interest</label>
              <select id="program" name="program">
                <option value="">Select a program...</option>
                <option value="private">Private Training</option>
                <option value="group">Small Group Training</option>
              </select>
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="4" placeholder="Tell me about your goals, age/level, preferred schedule..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary full-width">Send Message</button>
          </form>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer>
      <div class="container">
        <p class="logo">NDO <span>Futbol</span></p>
        <p class="footer-sub">Premier Soccer Development · Technical Growth · Confidence · Long-Term Success</p>
        <p class="footer-copy">&copy; 2026 NDO Futbol. All rights reserved.</p>
      </div>
    </footer>

    <script>
      const hamburger = document.getElementById('hamburger');
      const navLinks = document.getElementById('nav-links');

      hamburger.addEventListener('click', () => {
        const open = navLinks.classList.toggle('open');
        hamburger.classList.toggle('open', open);
        hamburger.setAttribute('aria-expanded', String(open));
      });

      navLinks.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          navLinks.classList.remove('open');
          hamburger.classList.remove('open');
          hamburger.setAttribute('aria-expanded', 'false');
        });
      });
    </script>

  </body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --orange: #FDB927;
    --yellow: #FDB927;
    --green: #FFD966;
    --dark: #1A0A3B;
    --purple: #552583;
    --white: #FFFFFF;
    --gray: #F4F0FB;
    --text: #1A0A3B;
    --text-muted: #5C4A8A;
    --font-display: 'Bebas Neue', sans-serif;
    --font-body: 'Inter', sans-serif;
    --radius: 12px;
    --shadow: 0 4px 24px rgba(85,37,131,0.12);
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-body);
    color: var(--text);
    background: var(--white);
    overflow-x: hidden;
  }

  .container { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

  /* ---- NAV ---- */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 40px;
    background: rgba(26,10,59,0.95);
    backdrop-filter: blur(12px);
  }

  nav ul { display: flex; gap: 32px; list-style: none; }
  nav ul a { color: rgba(255,255,255,0.8); text-decoration: none; font-weight: 500; font-size: 0.95rem; transition: color 0.2s; }
  nav ul a:hover { color: var(--yellow); }

  .logo-link { display: flex; align-items: center; text-decoration: none; }
  .nav-logo { height: 90px; width: auto; display: block; }

  .logo { font-family: var(--font-display); font-size: 1.8rem; letter-spacing: 2px; color: var(--white); text-decoration: none; }
  .logo span { color: var(--yellow); }

  /* ---- BUTTONS ---- */
  .btn {
    display: inline-block;
    padding: 13px 28px;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s;
    border: 2px solid transparent;
    cursor: pointer;
    font-family: var(--font-body);
  }
  .btn-primary { background: var(--yellow); color: var(--dark); }
  .btn-primary:hover { background: #e8a800; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(253,185,39,0.45); }
  .btn-outline { background: transparent; color: var(--white); border-color: rgba(255,255,255,0.5); }
  .btn-outline:hover { border-color: var(--yellow); color: var(--yellow); }
  .btn-nav { background: var(--yellow); color: var(--dark); padding: 10px 22px; font-size: 0.9rem; }
  .btn-nav:hover { background: #e8a800; }
  .full-width { width: 100%; text-align: center; }

  /* ---- HERO ---- */
  .hero {
    min-height: 100vh;
    background: var(--dark);
    display: flex; align-items: center;
    padding: 180px 40px 150px;
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 60% at 80% 50%, rgba(253,185,39,0.18) 0%, transparent 70%),
      radial-gradient(ellipse 40% 40% at 20% 80%, rgba(85,37,131,0.30) 0%, transparent 70%),
      radial-gradient(ellipse 50% 50% at 50% 20%, rgba(253,185,39,0.08) 0%, transparent 70%);
  }

  .hero-content {
    position: relative; z-index: 1;
    max-width: 700px;
  }

  .hero-eyebrow {
    font-size: 0.85rem; font-weight: 700; letter-spacing: 4px; text-transform: uppercase;
    color: var(--yellow); margin-bottom: 16px;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 8rem);
    line-height: 1;
    color: var(--white);
    margin-bottom: 24px;
    letter-spacing: 2px;
  }

  .hero h1 span { color: var(--yellow); /* Lakers gold */ }

  .hero-sub {
    font-size: 1.15rem; color: rgba(255,255,255,0.7);
    max-width: 500px; line-height: 1.7; margin-bottom: 40px;
  }

  .hero-cta { display: flex; gap: 16px; flex-wrap: wrap; }

  .hero-badge {
    position: absolute; right: 80px; bottom: 80px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    width: 120px; height: 120px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--yellow), #c49000);
    z-index: 1;
  }
  .badge-number { font-family: var(--font-display); font-size: 2.4rem; line-height: 1; color: var(--dark); }
  .badge-label { font-size: 0.7rem; font-weight: 700; text-align: center; color: var(--dark); text-transform: uppercase; letter-spacing: 1px; }

  /* ---- SECTION LABELS / HEADINGS ---- */
  .section-label {
    font-size: 0.8rem; font-weight: 700; letter-spacing: 4px; text-transform: uppercase;
    color: var(--orange); margin-bottom: 12px; display: block;
  }
  .center { text-align: center; }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    letter-spacing: 1px;
    line-height: 1.1;
    margin-bottom: 20px;
  }
  h2 span { color: var(--orange); }

  /* ---- ABOUT ---- */
  .about { padding: 100px 0; background: var(--white); }

  .about-grid {
    display: grid; grid-template-columns: 1fr 1.4fr; gap: 64px; align-items: center;
  }

  .about-visual {
    display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
  }

  .about-card {
    background: var(--gray);
    border-radius: var(--radius);
    padding: 28px 20px;
    text-align: center;
    transition: transform 0.2s;
  }
  .about-card:hover { transform: translateY(-4px); }
  .about-card.accent { background: var(--purple); grid-column: span 2; }
  .about-card.accent .about-stat, .about-card.accent .about-stat-label { color: var(--yellow); }
  .about-card.accent .about-icon { filter: none; }

  .about-icon { font-size: 2rem; margin-bottom: 12px; }
  .about-stat { font-family: var(--font-display); font-size: 2.4rem; color: var(--purple); line-height: 1; }
  .about-stat-label { font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-top: 4px; text-transform: uppercase; letter-spacing: 1px; }

  .about-text p { color: var(--text-muted); line-height: 1.8; margin-bottom: 16px; }

  .philosophy-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .tag {
    background: var(--gray); border-radius: 50px;
    padding: 8px 18px; font-size: 0.85rem; font-weight: 600; color: var(--text);
    border: 2px solid transparent; transition: all 0.2s;
  }
  .tag:hover { border-color: var(--purple); color: var(--purple); background: rgba(85,37,131,0.07); }

  /* ---- SERVICES ---- */
  .services { padding: 100px 0; background: var(--purple); }
  .services h2, .services .section-label { color: var(--white); }
  .services h2 span { color: var(--yellow); }
  .services h2, .services .section-label.center { margin-bottom: 0; }
  .services h2 { margin-bottom: 56px; }

  .services-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
  }
  .services-grid.two-col {
    grid-template-columns: repeat(2, 1fr); max-width: 800px; margin: 0 auto;
  }

  .service-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius);
    padding: 36px 28px;
    position: relative;
    transition: transform 0.2s, border-color 0.2s;
    display: flex; flex-direction: column; gap: 16px;
  }
  .service-card:hover { transform: translateY(-6px); border-color: rgba(253,185,39,0.5); }
  .service-card.featured { border-color: var(--yellow); background: rgba(253,185,39,0.10); }

  .featured-badge {
    position: absolute; top: -14px; left: 50%; transform: translateX(-50%);
    background: linear-gradient(90deg, var(--yellow), #c49000);
    color: #1A0A3B; font-size: 0.75rem; font-weight: 700;
    padding: 5px 16px; border-radius: 50px; white-space: nowrap;
    letter-spacing: 1px; text-transform: uppercase;
  }

  .service-icon { font-size: 2.2rem; }

  .service-card h3 {
    font-family: var(--font-display); font-size: 1.6rem; color: var(--white); letter-spacing: 1px;
  }

  .service-card p { color: rgba(255,255,255,0.65); line-height: 1.7; font-size: 0.95rem; }

  .service-card ul {
    list-style: none; display: flex; flex-direction: column; gap: 8px; flex: 1;
  }
  .service-card ul li {
    color: rgba(255,255,255,0.8); font-size: 0.9rem; padding-left: 20px; position: relative;
  }
  .service-card ul li::before { content: '✓'; position: absolute; left: 0; color: var(--yellow); font-weight: 700; }

  /* ---- TESTIMONIALS ---- */
  .testimonials { padding: 100px 0; background: var(--dark); }
  .testimonials .section-label { color: var(--yellow); }
  .testimonials h2 { color: var(--white); margin-bottom: 56px; }
  .testimonials h2 span { color: var(--yellow); }

  .testimonials-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
  }

  .testimonial-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius);
    padding: 36px 28px;
    display: flex; flex-direction: column; gap: 20px;
    transition: transform 0.2s, border-color 0.2s;
  }
  .testimonial-card:hover { transform: translateY(-6px); border-color: rgba(253,185,39,0.4); }
  .testimonial-card.featured { border-color: var(--yellow); background: rgba(253,185,39,0.07); }

  .stars { color: var(--yellow); font-size: 1.1rem; letter-spacing: 2px; }

  .quote {
    color: rgba(255,255,255,0.75); font-size: 0.95rem; line-height: 1.8;
    font-style: italic; flex: 1;
  }
  .quote::before { content: '\201C'; }
  .quote::after  { content: '\201D'; }

  .testimonial-author { display: flex; align-items: center; gap: 14px; }

  .author-avatar {
    width: 44px; height: 44px; border-radius: 50%;
    background: linear-gradient(135deg, var(--purple), var(--yellow));
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 1rem; color: var(--white); flex-shrink: 0;
  }
  .testimonial-card.featured .author-avatar {
    background: linear-gradient(135deg, var(--yellow), #c49000);
    color: var(--dark);
  }

  .author-name { font-weight: 700; font-size: 0.95rem; color: var(--white); }
  .author-role { font-size: 0.8rem; color: rgba(255,255,255,0.45); margin-top: 2px; }

  /* ---- GALLERY ---- */
  .gallery { padding: 100px 0; background: var(--white); }

  .gallery-grid {
    columns: 3;
    column-gap: 16px;
    margin-top: 48px;
  }

  .gallery-item {
    border-radius: var(--radius); overflow: hidden;
    break-inside: avoid;
    margin-bottom: 16px;
  }
  .gallery-item img { width: 100%; height: auto; display: block; }

  .gallery-placeholder {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, var(--gray) 0%, #e8e0f5 50%, var(--gray) 100%);
